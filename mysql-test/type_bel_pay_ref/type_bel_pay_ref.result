#
# BEL_PAY_REF_GENERATE()
#
SELECT BEL_PAY_REF_GENERATE('1234567890');
BEL_PAY_REF_GENERATE('1234567890')
+++123/4567/89002+++
SELECT BEL_PAY_REF_GENERATE('0000000000');
BEL_PAY_REF_GENERATE('0000000000')
+++000/0000/00097+++
SELECT BEL_PAY_REF_GENERATE('123456789');
BEL_PAY_REF_GENERATE('123456789')
NULL
SELECT BEL_PAY_REF_GENERATE('12345678901');
BEL_PAY_REF_GENERATE('12345678901')
NULL
SELECT BEL_PAY_REF_GENERATE(NULL);
BEL_PAY_REF_GENERATE(NULL)
NULL
#
# BEL_PAY_REF_GENERATE_PARTS()
#
# One argument: left-padded with zeroes to 10 digits.
SELECT BEL_PAY_REF_GENERATE_PARTS(42);
BEL_PAY_REF_GENERATE_PARTS(42)
+++000/0000/04242+++
SELECT BEL_PAY_REF_GENERATE_PARTS('0000000000');
BEL_PAY_REF_GENERATE_PARTS('0000000000')
+++000/0000/00097+++
# Two arguments: fixed prefix, sequence number padded to fill the rest.
SELECT BEL_PAY_REF_GENERATE_PARTS(123, 1);
BEL_PAY_REF_GENERATE_PARTS(123, 1)
+++123/0000/00137+++
SELECT BEL_PAY_REF_GENERATE_PARTS(123, 42);
BEL_PAY_REF_GENERATE_PARTS(123, 42)
+++123/0000/04278+++
# Invalid: non-digit input, combined length over 10 digits, NULL.
SELECT BEL_PAY_REF_GENERATE_PARTS('12x');
BEL_PAY_REF_GENERATE_PARTS('12x')
NULL
SELECT BEL_PAY_REF_GENERATE_PARTS('123456', '12345');
BEL_PAY_REF_GENERATE_PARTS('123456', '12345')
NULL
SELECT BEL_PAY_REF_GENERATE_PARTS(NULL);
BEL_PAY_REF_GENERATE_PARTS(NULL)
NULL
SELECT BEL_PAY_REF_GENERATE_PARTS(123, NULL);
BEL_PAY_REF_GENERATE_PARTS(123, NULL)
NULL
# Wrong argument count.
SELECT BEL_PAY_REF_GENERATE_PARTS();
ERROR 42000: Incorrect parameter count in the call to native function 'BEL_PAY_REF_GENERATE_PARTS'
SELECT BEL_PAY_REF_GENERATE_PARTS(1, 2, 3);
ERROR 42000: Incorrect parameter count in the call to native function 'BEL_PAY_REF_GENERATE_PARTS'
#
# CAST(... AS BEL_PAY_REF)
#
SELECT CAST('123456789002' AS BEL_PAY_REF);
CAST('123456789002' AS BEL_PAY_REF)
+++123/4567/89002+++
SELECT CAST('+++123/4567/89002+++' AS BEL_PAY_REF);
CAST('+++123/4567/89002+++' AS BEL_PAY_REF)
+++123/4567/89002+++
SELECT CAST(NULL AS BEL_PAY_REF);
CAST(NULL AS BEL_PAY_REF)
NULL
SELECT CAST('123456789002' AS BEL_PAY_REF CHARACTER SET binary);
ERROR HY000: Illegal parameter data type bel_pay_ref for operation 'CHARACTER SET binary'
#
# Multi-byte fixed-width charsets (ucs2/utf16/utf32) cannot carry the
# plain-ASCII BEL_PAY_REF output as single-byte code units and are
# rejected, consistently for both CAST and the string functions.
#
SELECT CAST('123456789002' AS BEL_PAY_REF CHARACTER SET ucs2);
ERROR 42000: This version of MariaDB doesn't yet support 'CAST(AS BEL_PAY_REF CHARACTER SET ucs2/utf16/utf32)'
SELECT BEL_PAY_REF_FORMAT(_ucs2 '123456789002');
ERROR 42000: This version of MariaDB doesn't yet support 'BEL_PAY_REF functions with CHARACTER SET ucs2/utf16/utf32'
SELECT BEL_PAY_REF_BASE(_ucs2 '123456789002');
ERROR 42000: This version of MariaDB doesn't yet support 'BEL_PAY_REF functions with CHARACTER SET ucs2/utf16/utf32'
# BEL_PAY_REF_GENERATE_PARTS() takes the charset of either argument
# into account, not just the first.
SELECT BEL_PAY_REF_GENERATE_PARTS(_ucs2 '123');
ERROR 42000: This version of MariaDB doesn't yet support 'BEL_PAY_REF functions with CHARACTER SET ucs2/utf16/utf32'
SELECT BEL_PAY_REF_GENERATE_PARTS(_ucs2 '123', '1');
ERROR 42000: This version of MariaDB doesn't yet support 'BEL_PAY_REF functions with CHARACTER SET ucs2/utf16/utf32'
SELECT BEL_PAY_REF_GENERATE_PARTS('123', _ucs2 '1');
ERROR 42000: This version of MariaDB doesn't yet support 'BEL_PAY_REF functions with CHARACTER SET ucs2/utf16/utf32'
# End of tests
